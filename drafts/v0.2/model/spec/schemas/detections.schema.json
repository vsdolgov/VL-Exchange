{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object", "additionalProperties":false, "required":["detections"],
  "properties":{"detections":{"type":"array", "maxItems":1000, "items":{
    "type":"object", "additionalProperties":false,
    "required":["object_id","label","category_id","score","bbox"],
    "properties":{
      "object_id":{"type":"string","minLength":1,"maxLength":128},
      "label":{"type":"string","minLength":1,"maxLength":256},
      "category_id":{"type":"integer","minimum":0},
      "score":{"type":"number","minimum":0,"maximum":1},
      "bbox":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0,"maximum":1}}
    }
  }}}
}
