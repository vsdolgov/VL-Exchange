{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vl-exchange:scenario-async-sequence:0.2.0-draft",
  "title": "VLSP optional asynchronous MLLM golden call/reset sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputs",
              "context",
              "expected"
            ],
            "properties": {
              "inputs": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "frame"
                    ],
                    "properties": {
                      "frame": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "frame_id",
                          "frame_ref",
                          "width",
                          "height"
                        ],
                        "properties": {
                          "frame_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "frame_ref": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "width": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mllm_result"
                    ],
                    "properties": {
                      "mllm_result": {
                        "$ref": "#/$defs/completion"
                      }
                    }
                  }
                ]
              },
              "context": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "run_id",
                  "sequence",
                  "event_time_ms"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "run_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "event_time_ms": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "expected": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "events",
                      "state"
                    ],
                    "properties": {
                      "events": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "event_id",
                            "event_type",
                            "source_id",
                            "run_id",
                            "sequence",
                            "event_time_ms",
                            "payload"
                          ],
                          "properties": {
                            "event_id": {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}$"
                            },
                            "event_type": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$",
                              "maxLength": 256
                            },
                            "source_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "run_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "sequence": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "event_time_ms": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "payload": {
                              "type": "object"
                            }
                          }
                        }
                      },
                      "state": {
                        "type": "object"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "error"
                    ],
                    "properties": {
                      "error": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "code",
                          "fatal",
                          "retryable"
                        ],
                        "properties": {
                          "code": {
                            "type": "string",
                            "minLength": 1
                          },
                          "fatal": {
                            "type": "boolean"
                          },
                          "retryable": {
                            "type": "boolean"
                          },
                          "stage": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reset"
            ],
            "properties": {
              "reset": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "run_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "dependentRequired": {
                  "run_id": [
                    "source_id"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "installation_id",
        "scenario_id",
        "scenario_version",
        "scenario_manifest_sha256"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "installation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scenario_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scenario_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "sha256",
        "expires_at_ms",
        "source_id",
        "run_id",
        "frame_id"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "model_id",
        "revision",
        "model_digest",
        "input_types",
        "output_types",
        "max_input_bytes",
        "max_output_bytes"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image"
            ]
          }
        },
        "output_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "structured"
            ]
          }
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "response_schema",
        "parameters"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 65536
        },
        "response_schema": {
          "type": [
            "object",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "job_id",
        "source_id",
        "run_id",
        "frame_id",
        "tracker_alias",
        "track_id",
        "source_event_time_ms",
        "model_alias",
        "model_revision",
        "payload",
        "media",
        "deadline_ms"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tracker_alias": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "track_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "source_event_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "model_alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/media"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "track_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "tracker_alias": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "tracker_alias": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "anyOf": [
            {
              "properties": {
                "media": {
                  "type": "object"
                }
              }
            },
            {
              "properties": {
                "payload": {
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "job_id",
        "source_id",
        "run_id",
        "frame_id",
        "tracker_alias",
        "track_id",
        "source_event_time_ms",
        "model_alias",
        "model_revision",
        "status",
        "text",
        "structured",
        "error"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tracker_alias": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "track_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "source_event_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "model_alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "timed_out",
            "cancelled"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 65536
        },
        "structured": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "track_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "tracker_alias": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "tracker_alias": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            },
            "anyOf": [
              {
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "properties": {
                  "structured": {
                    "type": "object"
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "text": {
                "type": "null"
              },
              "structured": {
                "type": "null"
              },
              "error": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models"
      ],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      }
    }
  }
}
