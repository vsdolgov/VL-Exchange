{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vl-exchange:scenario-package:0.1.0",
  "title": "VL Exchange — VL Scenario Package (VLSP) v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "spec_version",
    "scenario_id",
    "name",
    "version",
    "entrypoint",
    "files",
    "runtime",
    "input_contract",
    "event_contract",
    "parameters",
    "state",
    "ordering",
    "limits",
    "dependencies",
    "model_links",
    "required_capabilities",
    "golden",
    "delivery",
    "extensions"
  ],
  "properties": {
    "format": {
      "const": "vl.scenario-package"
    },
    "spec_version": {
      "const": "0.1.0"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$",
      "maxLength": 256
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "module",
        "class",
        "contract"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9_][A-Za-z0-9._/-]*$"
        },
        "module": {
          "const": "scenario.py"
        },
        "class": {
          "const": "Scenario"
        },
        "contract": {
          "const": "python-scenario-json-v1"
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 3,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9_][A-Za-z0-9._/-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version_specifier"
      ],
      "properties": {
        "python_version_specifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "message_type",
        "clock_domain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 128
        },
        "message_type": {
          "const": "vl.classification.v1"
        },
        "clock_domain": {
          "const": "unix-utc-ms"
        }
      }
    },
    "event_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "types"
      ],
      "properties": {
        "identity": {
          "const": "sha256-scenario-run-v1"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_type",
              "payload_schema"
            ],
            "properties": {
              "event_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$",
                "maxLength": 256
              },
              "payload_schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "default"
        ],
        "properties": {
          "type": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          },
          "default": {},
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "enum": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "initial",
        "schema"
      ],
      "properties": {
        "scope": {
          "const": "instance-source-run"
        },
        "initial": {
          "type": "object"
        },
        "schema": {
          "type": "object"
        }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_time",
        "unit"
      ],
      "properties": {
        "sequence": {
          "const": "strictly-increasing-per-source-run"
        },
        "event_time": {
          "const": "nondecreasing-per-source-run"
        },
        "unit": {
          "const": "milliseconds"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_process_ms",
        "max_input_bytes",
        "max_state_bytes",
        "max_events_per_call",
        "max_event_bytes"
      ],
      "properties": {
        "max_process_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 16777216
        },
        "max_state_bytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16777216
        },
        "max_events_per_call": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_event_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 16777216
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version_specifier"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "version_specifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "model_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "manifest_sha256",
          "profile",
          "required"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 128
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "allOf": [
        {
          "contains": {
            "const": "python-scenario-json-v1"
          }
        },
        {
          "contains": {
            "const": "classification-v1"
          }
        },
        {
          "contains": {
            "const": "event-json-v1"
          }
        },
        {
          "contains": {
            "const": "source-run-state-v1"
          }
        },
        {
          "contains": {
            "const": "event-id-sha256-v1"
          }
        }
      ]
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atol",
        "rtol",
        "sequences"
      ],
      "properties": {
        "atol": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.001
        },
        "rtol": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.001
        },
        "sequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                "maxLength": 128
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9_][A-Za-z0-9._/-]*$"
              }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production",
        "version",
        "plaintext"
      ],
      "properties": {
        "production": {
          "const": "vl.exchange.protected"
        },
        "version": {
          "const": "0.1.0"
        },
        "plaintext": {
          "const": "development-only"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$",
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "data"
        ],
        "properties": {
          "required": {
            "type": "boolean"
          },
          "data": {}
        }
      }
    }
  }
}
